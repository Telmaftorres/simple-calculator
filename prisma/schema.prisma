generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Study {
  id        Int      @id @default(autoincrement())
  number    String   @unique
  name      String?
  createdAt DateTime @default(now())
  quotes    Quote[]
}

model ProductType {
  id                Int               @id @default(autoincrement())
  name              String            @unique
  flatWidthFormula  String            @default("l")
  flatHeightFormula String            @default("L")
  elements          Element[]
  quotes            Quote[]
  templates         ProductTemplate[]
}

model ProductTemplate {
  id                          Int                       @id @default(autoincrement())
  productTypeId               Int?
  name                        String
  // ── Format à plat ──
  flatWidth                   Int?
  flatHeight                  Int?
  // ── Matière par défaut ──
  plateId                     Int?
  // ── Impression ──
  hasImpression               Boolean                   @default(true)
  printMode                   String                    @default("production")
  printSetupType              String                    @default("none")
  isRectoVerso                Boolean                   @default(false)
  rectoVersoType              String?
  hasVarnish                  Boolean                   @default(false)
  hasFlatColor                Boolean                   @default(false)
  inkMlPerPlate               Int                       @default(20)
  inkMlVerso                  Int                       @default(0)
  varnishSurfacePercent       Int                       @default(0)
  flatColorSurfacePercent     Int                       @default(0)
  // ── Découpe ──
  cuttingTimePerPoseSeconds   Int                       @default(0)
  cuttingSetupType            String                    @default("none")
  // ── Façonnage ──
  hasFaconnage                Boolean                   @default(true)
  assemblyTimePerPieceSeconds Int                       @default(0)
  // ── Conditionnement ──
  hasConditionnement          Boolean                   @default(true)
  packTimePerPieceSeconds     Int                       @default(0)
  hasAssemblyNotice           Boolean                   @default(false)
  // ── Accessoires ──
  hasAccessoires              Boolean                   @default(false)
  // ── Transport ──
  hasTransport                Boolean                   @default(false)
  defaultTransportMode        String?
  // ── Notes ──
  notes                       String?
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt
  productType                 ProductType?              @relation(fields: [productTypeId], references: [id], onDelete: SetNull)
  plate                       Plate?                    @relation(fields: [plateId], references: [id], onDelete: SetNull)
  quotes                      Quote[]
  accessories                 ProductTemplateAccessory[]
}

model ProductTemplateAccessory {
  id          Int             @id @default(autoincrement())
  templateId  Int
  accessoryId Int
  quantity    Int             @default(1)
  template    ProductTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  accessory   Accessory       @relation(fields: [accessoryId], references: [id])
}

model Element {
  id            Int         @id @default(autoincrement())
  name          String
  productTypeId Int
  quantity      Int         @default(1)
  productType   ProductType @relation(fields: [productTypeId], references: [id], onDelete: Cascade)
}

// ── Tarification emballage ──

model PackagingPricingRule {
  id            Int      @id @default(autoincrement())
  category      String   // 'ETUI' | 'CAISSE' | 'PLAQUE_RAINEE'
  material      String   // 'B' | 'EB' | 'C' | 'BC'
  size          String   // 'PETIT' | 'MOYEN' | 'GRAND'
  baseUnitPrice Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([category, material, size])
}

model QuantityCoefficient {
  id           Int      @id @default(autoincrement())
  quantityBand String   @unique // 'PETITE_SERIE' | 'MOYENNE_SERIE' | 'GRANDE_SERIE'
  minQuantity  Int
  maxQuantity  Int?     // null = pas de borne sup (GRANDE_SERIE)
  coefficient  Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Plate {
  id               Int               @id @default(autoincrement())
  name             String            @unique
  width            Int
  height           Int
  cost             Float
  material         String
  quotes           Quote[]
  packagingQuotes  Quote[]           @relation("PackagingPlate")
  quoteProducts    QuoteProduct[]
  templates        ProductTemplate[]
}

model Accessory {
  id                 Int                        @id @default(autoincrement())
  name               String
  description        String?
  price              Float
  supplier           String?
  weight             Float?
  quoteAccessories   QuoteAccessory[]
  templateAccessories ProductTemplateAccessory[]
}

model Quote {
  id                                 Int               @id @default(autoincrement())
  reference                          String?           @unique
  parentReference                    String?
  client                             String?
  contactName                        String?
  studyId                            Int
  productTypeId                      Int
  quantity                           Int
  flatWidth                          Int
  flatHeight                         Int
  printMode                          String            @default("production")
  isRectoVerso                       Boolean           @default(false)
  rectoVersoType                     String?
  inkMlPerPlate                      Int?              @default(0)
  inkMlVerso                         Int?              @default(0)
  varnishSurfacePercent              Int               @default(0)
  flatColorSurfacePercent            Int               @default(0)
  hasVarnish                         Boolean           @default(false)
  hasFlatColor                       Boolean           @default(false)
  cuttingTimePerPoseSeconds          Int               @default(0)
  assemblyTimePerPieceSeconds        Int               @default(0)
  packTimePerPieceSeconds            Int               @default(0)
  hasAssemblyNotice                  Boolean           @default(false)
  plateId                            Int?
  plateCostOverride                  Float?            // prix/plaque négocié, écrase le tarif catalogue
  customPlateName                    String?           // matière personnalisée (non enregistrée en DB)
  customPlateWidth                   Int?
  customPlateHeight                  Int?
  customPlateCost                    Float?
  itemsPerPlate                      Int?
  platesCount                        Int?
  totalCost                          Float?
  hasPackaging                       Boolean           @default(false)
  packagingBoxType                   String?           // 'etui' | 'caisse' | 'plaque_rainee'
  packagingMaterialType              String?           // 'B' | 'EB' | 'C' | 'BC'
  packagingExternalSize              String?           // 'petit' | 'moyen' | 'grand' (pour B/EB)
  packagingProductLength             Int?              // longueur du produit fini (mm)
  packagingProductWidth              Int?              // largeur du produit fini (mm)
  packagingProductHeight             Int?              // hauteur du produit fini (mm, pour caisse)
  packagingProductThickness          Int?              // épaisseur du produit fini (mm, pour étui)
  packagingPlateId                   Int?
  packagingQuantity                  Int?
  packagingCuttingTimePerPoseSeconds Int               @default(20)
  packagingWidth                     Int?              // longueur carton calculée (mm)
  packagingHeight                    Int?              // largeur carton calculée (mm)
  createdAt                          DateTime          @default(now())
  updatedAt                          DateTime          @updatedAt
  userId                             String?
  plate                              Plate?            @relation(fields: [plateId], references: [id])
  packagingPlate                     Plate?            @relation("PackagingPlate", fields: [packagingPlateId], references: [id])
  productType                        ProductType       @relation(fields: [productTypeId], references: [id])
  study                              Study             @relation(fields: [studyId], references: [id])
  user                               User?             @relation(fields: [userId], references: [id])
  accessories                        QuoteAccessory[]
  consumables                        QuoteConsumable[]
  elements                           QuoteElement[]
  printSetupType                     String           @default("none")
  cuttingSetupType                   String           @default("none")
  hasImpression                      Boolean           @default(true)
  hasFaconnage                       Boolean           @default(true)
  hasConditionnement                 Boolean           @default(true)
  hasAccessoires                     Boolean           @default(false)
  isMultiProduct                     Boolean           @default(false)
  products                           QuoteProduct[]
  hasBE                              Boolean           @default(false)
  beTimeMinutes                      Int               @default(0)
  batTimeMinutes                     Int               @default(0)
  hasDossierFee                      Boolean           @default(false)
  showMargeCommerciale               Boolean           @default(false)
  showMargeSopano                    Boolean           @default(false)
  // ── Transport ──
  transportTotal                     Float?            // total HT toutes livraisons confondues
  transportShipments                 TransportShipment[]
  transportDeliveries                QuoteTransportDelivery[]
  actuals                            QuoteActuals?
  productionSheet                    ProductionSheet?
  templateId                         Int?              // modèle standard utilisé à la création
  template                           ProductTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  sentByUserId                       String?
  sentByUserName                     String?

  @@index([userId, createdAt])
}

model ProductionSheet {
  id        Int      @id @default(autoincrement())
  quoteId   Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Paramètres de production (overrides du devis) ──
  prodCuttingTimePerPoseSeconds   Float?   // Temps découpe planifié (sec/pose)
  prodAssemblyTimePerPieceSeconds Float?   // Temps façonnage planifié (sec/pce)
  prodPackTimePerPieceSeconds     Float?   // Temps conditionnement planifié (sec/pce)
  prodInkMlPerPlate               Float?   // Encre planifiée (ml/plaque)
  prodPlatesCount                 Int?     // Nb plaques planifié
  prodTransportCost               Float?   // Coût transport planifié (€ HT)
  prodTransportNotes              String?  // Notes transport / mode prévu

  // ── Façonnage ──
  nbCollages        Int?     // Nombre de collages
  collagePerPLV     Float?   // Mt. collage / PLV
  faconnageNotes    String?  // Description façonnage

  // ── Conditionnement ──
  conditionnementType  String?  // "kit_unitaire" | "caisse" | "palette" | autre
  conditionnementNotes String?  // Description libre

  // ── Achats / Accessoires ──
  achatsNotes  String?  // Texte libre accessoires à commander

  // ── Remarques générales ──
  remarques    String?

  // ── Plan technique ──
  planImageUrl String?  // URL de l'image téléversée

  // ── Statut ──
  status       String   @default("en_attente") // "en_attente" | "en_cours" | "termine"

  // ── Snapshot calculateur (JSON) ──
  formDataJson String?  // Sérialisation complète de l'état du calculateur en mode fiche de prod

  quote        Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

model QuoteActuals {
  id        Int      @id @default(autoincrement())
  quoteId   Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Temps réels par pièce (méthode principale — affichée dans l'UI) ──
  actualCuttingTimePerPoseSeconds   Float?   // Découpe réelle (sec/pose)
  actualAssemblyTimePerPieceSeconds Float?   // Façonnage réel (sec/pce)
  actualPackTimePerPieceSeconds     Float?   // Conditionnement réel (sec/pce)

  // ── Matière réelle ──
  actualPlatesUsed                  Int?     // Plaques réellement consommées
  actualWastePercent                Float?   // % de chutes constatées

  // ── Transport réel ──
  actualTransportMode               String?
  actualTransportCost               Float?
  actualWeightKg                    Float?

  // ── Notes libres ──
  notes                             String?

  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}


model Consumable {
  id               Int               @id @default(autoincrement())
  name             String
  price            Float
  size             Float
  quoteConsumables QuoteConsumable[]
}

model QuoteConsumable {
  id           Int        @id @default(autoincrement())
  quoteId      Int
  consumableId Int
  sizePerItem  Float
  consumable   Consumable @relation(fields: [consumableId], references: [id])
  quote        Quote      @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

model QuoteElement {
  id      Int    @id @default(autoincrement())
  quoteId Int
  name    String
  quantity Int
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

model QuoteAccessory {
  id          Int       @id @default(autoincrement())
  quoteId     Int
  accessoryId Int
  quantity    Int
  accessory   Accessory @relation(fields: [accessoryId], references: [id])
  quote       Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  password           String
  name               String?
  firstName          String?
  lastName           String?
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  permissions        String[]
  role               Role     @default(USER)
  quotes             Quote[]
}

enum Role {
  ADMIN
  USER
}

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  label     String
  unit      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QuoteProduct {
  id                        Int     @id @default(autoincrement())
  quoteId                   Int
  position                  Int     @default(0)
  productTypeId             Int?
  productTypeName           String?
  flatWidth                 Int     @default(0)
  flatHeight                Int     @default(0)
  quantity                  Int     @default(0)
  plateId                   Int?
  itemsPerPlate             Int?
  platesCount               Int?
  printMode                 String  @default("production")
  isRectoVerso              Boolean @default(false)
  rectoVersoType            String?
  inkMlPerPlate             Int     @default(0)
  inkMlVerso                Int     @default(0)
  varnishSurfacePercent     Int     @default(0)
  flatColorSurfacePercent   Int     @default(0)
  hasVarnish                Boolean @default(false)
  hasFlatColor              Boolean @default(false)
  hasImpression             Boolean @default(true)
  cuttingTimePerPoseSeconds Int     @default(0)
  printSetupType            String  @default("none")
  cuttingSetupType          String  @default("none")
  totalCost                 Float?
  quote                     Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  plate                     Plate?  @relation(fields: [plateId], references: [id])
}

model QuoteTransportDelivery {
  id            Int     @id @default(autoincrement())
  quoteId       Int
  transportMode String
  department    String
  weightKg      Float?
  units         Int     @default(1)
  optionsHT     Float   @default(0)
  basePriceHT   Float   @default(0)
  totalHT       Float   @default(0)
  quote         Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now())
  userId     String?
  userName   String?
  action     String   // "CREATE_QUOTE" | "DELETE_QUOTE" | "UPSERT_ACTUALS" | "CREATE_USER" | "UPDATE_USER" | "DELETE_USER" | "UPDATE_SETTING"
  entityType String   // "Quote" | "User" | "Setting"
  entityRef  String?  // référence lisible : numéro de devis, email, clé setting
  details    String?  // JSON libre
}

model TransportShipment {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  clientName    String
  plvType       String   // ex: "Présentoir comptoir", "Totem", "Cube"
  plvFormat     String   // ex: "350x276x275mm"
  quantity      Int
  transportMode String   // "PACK30" | "MESSAGERIE_PLUS" | "AFFRETEMENT"
  department    String
  weightKg      Float
  units         Int      // colis ou palettes
  basePriceHT   Float
  optionsHT     Float    @default(0)
  totalHT       Float
  notes         String?
  quoteId       Int?
  quote         Quote?   @relation(fields: [quoteId], references: [id], onDelete: SetNull)
}