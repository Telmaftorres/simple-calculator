generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Study {
  id        Int      @id @default(autoincrement())
  number    String   @unique
  name      String?
  createdAt DateTime @default(now())
  quotes    Quote[]
}

model ProductType {
  id                Int       @id @default(autoincrement())
  name              String    @unique
  flatWidthFormula  String    @default("l")
  flatHeightFormula String    @default("L")
  elements          Element[]
  quotes            Quote[]
}

model Element {
  id            Int         @id @default(autoincrement())
  name          String
  productTypeId Int
  quantity      Int         @default(1)
  productType   ProductType @relation(fields: [productTypeId], references: [id], onDelete: Cascade)
}

model Plate {
  id              Int     @id @default(autoincrement())
  name            String  @unique
  width           Int
  height          Int
  cost            Float
  material        String
  quotes          Quote[]
  packagingQuotes Quote[] @relation("PackagingPlate")
  quoteProducts   QuoteProduct[]
}

model Accessory {
  id               Int              @id @default(autoincrement())
  name             String
  description      String?
  price            Float
  supplier         String?
  weight           Float?
  quoteAccessories QuoteAccessory[]
}

model Quote {
  id                                 Int               @id @default(autoincrement())
  reference                          String?           @unique
  parentReference                    String?
  studyId                            Int
  productTypeId                      Int
  quantity                           Int
  flatWidth                          Int
  flatHeight                         Int
  printMode                          String            @default("production")
  isRectoVerso                       Boolean           @default(false)
  rectoVersoType                     String?
  inkMlPerPlate                      Int?              @default(0)
  varnishSurfacePercent              Int               @default(0)
  flatColorSurfacePercent            Int               @default(0)
  hasVarnish                         Boolean           @default(false)
  hasFlatColor                       Boolean           @default(false)
  cuttingTimePerPoseSeconds          Int               @default(0)
  assemblyTimePerPieceSeconds        Int               @default(0)
  packTimePerPieceSeconds            Int               @default(0)
  hasAssemblyNotice                  Boolean           @default(false)
  plateId                            Int?
  itemsPerPlate                      Int?
  platesCount                        Int?
  totalCost                          Float?
  hasPackaging                       Boolean           @default(false)
  packagingPlateId                   Int?
  packagingQuantity                  Int?
  packagingCuttingTimePerPoseSeconds Int               @default(20)
  packagingWidth                     Int?
  packagingHeight                    Int?
  createdAt                          DateTime          @default(now())
  updatedAt                          DateTime          @updatedAt
  userId                             String?
  plate                              Plate?            @relation(fields: [plateId], references: [id])
  packagingPlate                     Plate?            @relation("PackagingPlate", fields: [packagingPlateId], references: [id])
  productType                        ProductType       @relation(fields: [productTypeId], references: [id])
  study                              Study             @relation(fields: [studyId], references: [id])
  user                               User?             @relation(fields: [userId], references: [id])
  accessories                        QuoteAccessory[]
  consumables                        QuoteConsumable[]
  elements                           QuoteElement[]
  printSetupType                     String           @default("none")
  cuttingSetupType                   String           @default("none")
  hasImpression                      Boolean           @default(true)
  hasFaconnage                       Boolean           @default(true)
  hasConditionnement                 Boolean           @default(true)
  hasAccessoires                     Boolean           @default(false)
  isMultiProduct                     Boolean           @default(false)
  products                           QuoteProduct[]
  hasBE                              Boolean           @default(false)
  beTimeMinutes                      Int               @default(0)
  batTimeMinutes                     Int               @default(0)
  hasDossierFee                      Boolean           @default(false)
  showMargeCommerciale               Boolean           @default(false)
  showMargeSopano                    Boolean           @default(false)
  // ── Transport ──
  transportMode                      String?           // "PACK30" | "MESSAGERIE_PLUS" | "AFFRETEMENT"
  transportDepartment                String?           // ex: "76", "75", "13"
  transportWeight                    Float?            // poids total en kg
  transportUnits                     Int?              // nombre de colis ou palettes
  transportBasePrice                 Float?            // prix base HT calculé
  transportOptions                   Float?            // options manuelles HT
  transportTotal                     Float?            // total transport HT
  transportShipments                 TransportShipment[]
  transportDeliveries                QuoteTransportDelivery[]
}


model Consumable {
  id               Int               @id @default(autoincrement())
  name             String
  price            Float
  size             Float
  quoteConsumables QuoteConsumable[]
}

model QuoteConsumable {
  id           Int        @id @default(autoincrement())
  quoteId      Int
  consumableId Int
  sizePerItem  Float
  consumable   Consumable @relation(fields: [consumableId], references: [id])
  quote        Quote      @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

model QuoteElement {
  id      Int    @id @default(autoincrement())
  quoteId Int
  name    String
  quantity Int
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

model QuoteAccessory {
  id          Int       @id @default(autoincrement())
  quoteId     Int
  accessoryId Int
  quantity    Int
  accessory   Accessory @relation(fields: [accessoryId], references: [id])
  quote       Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  password           String
  name               String?
  firstName          String?
  lastName           String?
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  permissions        String[]
  role               Role     @default(USER)
  quotes             Quote[]
}

enum Role {
  ADMIN
  USER
}

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  label     String
  unit      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QuoteProduct {
  id                        Int     @id @default(autoincrement())
  quoteId                   Int
  position                  Int     @default(0)
  productTypeId             Int?
  productTypeName           String?
  flatWidth                 Int     @default(0)
  flatHeight                Int     @default(0)
  quantity                  Int     @default(0)
  plateId                   Int?
  itemsPerPlate             Int?
  platesCount               Int?
  printMode                 String  @default("production")
  isRectoVerso              Boolean @default(false)
  rectoVersoType            String?
  inkMlPerPlate             Int     @default(0)
  varnishSurfacePercent     Int     @default(0)
  flatColorSurfacePercent   Int     @default(0)
  hasVarnish                Boolean @default(false)
  hasFlatColor              Boolean @default(false)
  hasImpression             Boolean @default(true)
  cuttingTimePerPoseSeconds Int     @default(0)
  printSetupType            String  @default("none")
  cuttingSetupType          String  @default("none")
  totalCost                 Float?
  quote                     Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  plate                     Plate?  @relation(fields: [plateId], references: [id])
}

model QuoteTransportDelivery {
  id            Int     @id @default(autoincrement())
  quoteId       Int
  transportMode String
  department    String
  weightKg      Float?
  units         Int     @default(1)
  optionsHT     Float   @default(0)
  basePriceHT   Float   @default(0)
  totalHT       Float   @default(0)
  quote         Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

model TransportShipment {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  clientName    String
  plvType       String   // ex: "Présentoir comptoir", "Totem", "Cube"
  plvFormat     String   // ex: "350x276x275mm"
  quantity      Int
  transportMode String   // "PACK30" | "MESSAGERIE_PLUS" | "AFFRETEMENT"
  department    String
  weightKg      Float
  units         Int      // colis ou palettes
  basePriceHT   Float
  optionsHT     Float    @default(0)
  totalHT       Float
  notes         String?
  quoteId       Int?
  quote         Quote?   @relation(fields: [quoteId], references: [id], onDelete: SetNull)
}