generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users                   User[]
  studies                 Study[]
  quotes                  Quote[]
  plates                  Plate[]
  accessories             Accessory[]
  consumables             Consumable[]
  productTypes            ProductType[]
  packagingSupplierQuotes PackagingSupplierQuote[]
  packagingPricingRules   PackagingPricingRule[]
  quantityCoefficients    QuantityCoefficient[]
  settings                Setting[]
  auditLogs               AuditLog[]
  transportShipments      TransportShipment[]
}

model Study {
  id        Int      @id @default(autoincrement())
  number    String   @unique
  name      String?
  createdAt DateTime @default(now())
  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id])
  quotes    Quote[]
}

model ProductType {
  id                Int               @id @default(autoincrement())
  name              String            @unique
  companyId         Int?
  company           Company?          @relation(fields: [companyId], references: [id])
  flatWidthFormula  String            @default("l")
  flatHeightFormula String            @default("L")
  imageUrl          String?
  elements          Element[]
  quotes            Quote[]
  templates         ProductTemplate[]
  options           ProductOption[]
}

model ProductOption {
  id            Int                    @id @default(autoincrement())
  productTypeId Int
  name          String
  inputType     String                 // "single_choice" | "multi_item"
  priceHT       Float?
  position      Int                    @default(0)
  createdAt     DateTime               @default(now())
  productType   ProductType            @relation(fields: [productTypeId], references: [id], onDelete: Cascade)
  variants              ProductOptionVariant[]
  templateOptionConfigs ProductTemplateOptionConfig[]
}

model ProductOptionVariant {
  id              Int                          @id @default(autoincrement())
  optionId        Int
  label           String
  priceHT         Float?
  position        Int                          @default(0)
  option          ProductOption                @relation(fields: [optionId], references: [id], onDelete: Cascade)
  templateConfigs ProductTemplateVariantConfig[]
}

model ProductTemplate {
  id                          Int                       @id @default(autoincrement())
  productTypeId               Int?
  name                        String
  // ── Format ──
  formatType                  String                    @default("2d") // "2d" | "3d"
  flatWidth                   Int?
  flatDepth                   Int?
  flatHeight                  Int?
  // ── Matière par défaut ──
  plateId                     Int?
  // ── Impression ──
  hasImpression               Boolean                   @default(true)
  printMode                   String                    @default("production")
  printSetupType              String                    @default("none")
  isRectoVerso                Boolean                   @default(false)
  rectoVersoType              String?
  hasVarnish                  Boolean                   @default(false)
  hasFlatColor                Boolean                   @default(false)
  inkMlPerPlate               Int                       @default(20)
  inkMlVerso                  Int                       @default(0)
  varnishSurfacePercent       Int                       @default(0)
  flatColorSurfacePercent     Int                       @default(0)
  // ── Découpe ──
  cuttingTimePerPoseSeconds   Int                       @default(0)
  cuttingSetupType            String                    @default("none")
  // ── Façonnage ──
  hasFaconnage                Boolean                   @default(true)
  assemblyTimePerPieceSeconds Int                       @default(0)
  // ── Conditionnement ──
  hasConditionnement          Boolean                   @default(true)
  packTimePerPieceSeconds     Int                       @default(0)
  hasAssemblyNotice           Boolean                   @default(false)
  hasPoseEtiquette            Boolean                   @default(false)
  // ── Accessoires ──
  hasAccessoires              Boolean                   @default(false)
  accessoriesMargePercent     Float                     @default(0)
  packagingMargePercent       Float                     @default(0)
  // ── Transport ──
  hasTransport                Boolean                   @default(false)
  defaultTransportMode        String?
  // ── Amalgame ──
  hasAmalgame                 Boolean                   @default(false)
  amalgameGroupsJson          String?
  // ── Notes ──
  notes                       String?
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt
  productType                 ProductType?              @relation(fields: [productTypeId], references: [id], onDelete: SetNull)
  plate                       Plate?                    @relation(fields: [plateId], references: [id], onDelete: SetNull)
  quotes                      Quote[]
  accessories                 ProductTemplateAccessory[]
  amalgameRuns                ProductTemplateAmalgameRun[]
  templateElements            ProductTemplateElement[]
  templateVariants            ProductTemplateVariantConfig[]
  templateOptionConfigs       ProductTemplateOptionConfig[]
}

model ProductTemplateAmalgameRun {
  id            Int                              @id @default(autoincrement())
  templateId    Int
  name          String
  plateId       Int?
  hasImpression Boolean                          @default(true)
  mainPerPlate  Int?
  position      Int                              @default(0)
  template      ProductTemplate                  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  plate         Plate?                           @relation(fields: [plateId], references: [id], onDelete: SetNull)
  items         ProductTemplateAmalgameRunItem[]
}

model ProductTemplateAmalgameRunItem {
  id              Int                        @id @default(autoincrement())
  runId           Int
  name            String
  flatWidth       Int
  flatHeight      Int
  countPerPlate   Int
  quantityPerUnit Int                        @default(1)
  run             ProductTemplateAmalgameRun @relation(fields: [runId], references: [id], onDelete: Cascade)
}

model ProductTemplateAccessory {
  id          Int             @id @default(autoincrement())
  templateId  Int
  accessoryId Int
  quantity    Int             @default(1)
  template    ProductTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  accessory   Accessory       @relation(fields: [accessoryId], references: [id])
}

model ProductTemplateElement {
  id                       Int             @id @default(autoincrement())
  templateId               Int
  elementId                Int
  quantity                 Int             @default(1)
  flatWidth                Int?
  flatHeight               Int?
  flatDepth                Int?
  plateId                  Int?
  amalgameGroupId          String?
  hasImpression            Boolean         @default(true)
  printMode                String          @default("production")
  printSetupType           String          @default("none")
  isRectoVerso             Boolean         @default(false)
  rectoVersoType           String?
  hasVarnish               Boolean         @default(false)
  hasFlatColor             Boolean         @default(false)
  inkMlPerPlate            Int             @default(20)
  inkMlVerso               Int             @default(0)
  varnishSurfacePercent    Int             @default(0)
  flatColorSurfacePercent  Int             @default(0)
  cuttingTimePerPoseSeconds Int            @default(0)
  cuttingSetupType         String          @default("none")
  template   ProductTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  element    Element         @relation(fields: [elementId], references: [id], onDelete: Cascade)

  @@unique([templateId, elementId])
}

model ProductTemplateVariantConfig {
  id              Int                  @id @default(autoincrement())
  templateId      Int
  variantId       Int
  defaultQuantity Int                  @default(1)
  template        ProductTemplate      @relation(fields: [templateId], references: [id], onDelete: Cascade)
  variant         ProductOptionVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([templateId, variantId])
}

model ProductTemplateOptionConfig {
  id              Int             @id @default(autoincrement())
  templateId      Int
  optionId        Int
  defaultQuantity Int             @default(1)
  template        ProductTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  option          ProductOption   @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([templateId, optionId])
}

model Element {
  id               Int                      @id @default(autoincrement())
  name             String
  productTypeId    Int
  quantity         Int                      @default(1)
  isOption         Boolean                  @default(false)
  productType      ProductType              @relation(fields: [productTypeId], references: [id], onDelete: Cascade)
  templateElements ProductTemplateElement[]
}

// ── Tarification emballage ──

model PackagingSupplierQuote {
  id           Int      @id @default(autoincrement())
  companyId    Int?
  company      Company? @relation(fields: [companyId], references: [id])
  supplierName String
  category     String   // 'ETUI' | 'CAISSE' | 'PLAQUE_RAINEE'
  material     String   // 'B' | 'EB'
  dimWidth     Float?   // largeur en mm
  dimHeight    Float?   // hauteur en mm
  dimDepth     Float?   // profondeur en mm
  unitPrice    Float
  quotedAt     DateTime @default(now())
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PackagingPricingRule {
  id            Int      @id @default(autoincrement())
  companyId     Int?
  company       Company? @relation(fields: [companyId], references: [id])
  category      String   // 'ETUI' | 'CAISSE' | 'PLAQUE_RAINEE'
  material      String   // 'B' | 'EB' | 'C' | 'BC'
  size          String   // 'PETIT' | 'MOYEN' | 'GRAND'
  baseUnitPrice Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([category, material, size])
}

model QuantityCoefficient {
  id           Int      @id @default(autoincrement())
  companyId    Int?
  company      Company? @relation(fields: [companyId], references: [id])
  quantityBand String   @unique // 'PETITE_SERIE' | 'MOYENNE_SERIE' | 'GRANDE_SERIE'
  minQuantity  Int
  maxQuantity  Int?     // null = pas de borne sup (GRANDE_SERIE)
  coefficient  Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Plate {
  id               Int               @id @default(autoincrement())
  companyId        Int?
  company          Company?          @relation(fields: [companyId], references: [id])
  name             String            @unique
  width            Int
  height           Int
  cost             Float
  material         String
  quotes                    Quote[]
  packagingQuotes           Quote[]                        @relation("PackagingPlate")
  quoteProducts             QuoteProduct[]
  templates                 ProductTemplate[]
  templateAmalgameRuns      ProductTemplateAmalgameRun[]
  quoteAmalgameRuns         QuoteAmalgameRun[]
  productionProductLines    ProductionProductLine[]
  productionProductLineElements ProductionProductLineElement[]
}

model Accessory {
  id                  Int                        @id @default(autoincrement())
  companyId           Int?
  company             Company?                   @relation(fields: [companyId], references: [id])
  name                String
  description         String?
  price               Float
  supplier            String?
  supplierRef         String?
  supplierUrl         String?
  lotSize             Int?
  imageUrl            String?
  weight              Float?
  quoteAccessories    QuoteAccessory[]
  templateAccessories ProductTemplateAccessory[]
}

model Quote {
  id                                 Int               @id @default(autoincrement())
  reference                          String?           @unique
  parentReference                    String?
  client                             String?
  contactName                        String?
  studyId                            Int
  productTypeId                      Int?
  quantity                           Int
  flatWidth                          Int
  flatHeight                         Int
  printMode                          String            @default("production")
  isRectoVerso                       Boolean           @default(false)
  rectoVersoType                     String?
  inkMlPerPlate                      Int?              @default(0)
  inkMlVerso                         Int?              @default(0)
  varnishSurfacePercent              Int               @default(0)
  flatColorSurfacePercent            Int               @default(0)
  hasVarnish                         Boolean           @default(false)
  hasFlatColor                       Boolean           @default(false)
  cuttingTimePerPoseSeconds          Int               @default(0)
  machineTimeMinOverride             Float?
  itemsPerPlateOverride              Int?
  bordABord                          Boolean           @default(false)
  assemblyTimePerPieceSeconds        Int               @default(0)
  packTimePerPieceSeconds            Int               @default(0)
  hasAssemblyNotice                  Boolean           @default(false)
  hasPoseEtiquette                   Boolean           @default(false)
  plateId                            Int?
  plateCostOverride                  Float?            // prix/plaque négocié, écrase le tarif catalogue
  customPlateName                    String?           // matière personnalisée (non enregistrée en DB)
  customPlateWidth                   Int?
  customPlateHeight                  Int?
  customPlateCost                    Float?
  itemsPerPlate                      Int?
  platesCount                        Int?
  totalCost                          Float?
  hasPackaging                       Boolean           @default(false)
  packagingBoxType                   String?           // 'etui' | 'caisse' | 'plaque_rainee'
  packagingMaterialType              String?           // 'B' | 'EB' | 'C' | 'BC'
  packagingExternalSize              String?           // 'petit' | 'moyen' | 'grand' (pour B/EB)
  packagingProductLength             Int?              // longueur du produit fini (mm)
  packagingProductWidth              Int?              // largeur du produit fini (mm)
  packagingProductHeight             Int?              // hauteur du produit fini (mm, pour caisse)
  packagingProductThickness          Int?              // épaisseur du produit fini (mm, pour étui)
  packagingPlateId                   Int?
  packagingQuantity                  Int?
  packagingCuttingTimePerPoseSeconds Int               @default(20)
  packagingWidth                     Int?              // longueur carton calculée (mm)
  packagingHeight                    Int?              // largeur carton calculée (mm)
  packagingUnitPriceOverride         Float?
  createdAt                          DateTime          @default(now())
  updatedAt                          DateTime          @updatedAt
  userId                             String?
  plate                              Plate?            @relation(fields: [plateId], references: [id])
  packagingPlate                     Plate?            @relation("PackagingPlate", fields: [packagingPlateId], references: [id])
  productType                        ProductType?      @relation(fields: [productTypeId], references: [id])
  study                              Study             @relation(fields: [studyId], references: [id])
  user                               User?             @relation(fields: [userId], references: [id])
  accessories                        QuoteAccessory[]
  consumables                        QuoteConsumable[]
  elements                           QuoteElement[]
  printSetupType                     String           @default("none")
  cuttingSetupType                   String           @default("none")
  hasImpression                      Boolean           @default(true)
  hasFaconnage                       Boolean           @default(true)
  hasConditionnement                 Boolean           @default(true)
  hasAccessoires                     Boolean           @default(false)
  accessoriesMargePercent            Float             @default(0)
  packagingMargePercent              Float             @default(0)
  isMultiProduct                     Boolean           @default(false)
  plvQuantity                        Int?              // Nombre de PLV (mode multi-produit) — base pour façonnage, conditionnement, transport
  products                           QuoteProduct[]
  hasBE                              Boolean           @default(false)
  beTimeMinutes                      Int               @default(0)
  batTimeMinutes                     Int               @default(0)
  hasDossierFee                      Boolean           @default(false)
  showMargeCommerciale               Boolean           @default(false)
  showMargeSopano                    Boolean           @default(false)
  // ── Transport ──
  transportTotal                     Float?            // total HT toutes livraisons confondues
  transportShipments                 TransportShipment[]
  transportDeliveries                QuoteTransportDelivery[]
  actuals                            QuoteActuals?
  productionSheet                    ProductionSheet?
  templateId                         Int?              // modèle standard utilisé à la création
  template                           ProductTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  sentByUserId                       String?
  sentByUserName                     String?
  // ── Amalgame ──
  hasAmalgame                        Boolean           @default(false)
  amalgameRuns                       QuoteAmalgameRun[]
  // ── CRM sync ──
  crmQuoteId                         String?           @unique  // ID du devis dans le CRM (pour dédupliquer les syncs)
  crmSyncedAt                        DateTime?                  // Date de création auto depuis le CRM
  companyId                          Int?
  company                            Company?          @relation(fields: [companyId], references: [id])

  @@index([userId, createdAt])
}

model QuoteAmalgameRun {
  id                        Int                    @id @default(autoincrement())
  quoteId                   Int
  name                      String
  plateId                   Int?
  hasImpression             Boolean                @default(true)
  cuttingSetupType          String                 @default("none")
  cuttingTimePerPoseSeconds Float                  @default(0)
  printMode                 String                 @default("production")
  isRectoVerso              Boolean                @default(false)
  rectoVersoType            String?
  inkMlPerPlate             Float                  @default(20)
  inkMlVerso                Float                  @default(0)
  hasVarnish                Boolean                @default(false)
  hasFlatColor              Boolean                @default(false)
  varnishSurfacePercent     Float                  @default(0)
  flatColorSurfacePercent   Float                  @default(0)
  printSetupType            String                 @default("none")
  machineTimeMinOverride    Float?
  mainPerPlate              Int?
  platesCount               Int?
  position                  Int                    @default(0)
  quote         Quote                  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  plate         Plate?                 @relation(fields: [plateId], references: [id], onDelete: SetNull)
  items         QuoteAmalgameRunItem[]
}

model QuoteAmalgameRunItem {
  id              Int              @id @default(autoincrement())
  runId           Int
  name            String
  flatWidth       Int
  flatHeight      Int
  countPerPlate   Int
  quantityPerUnit Int              @default(1)
  run             QuoteAmalgameRun @relation(fields: [runId], references: [id], onDelete: Cascade)
}

model ProductionSheet {
  id        Int      @id @default(autoincrement())
  quoteId   Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Paramètres de production (overrides du devis) ──
  prodCuttingTimePerPoseSeconds   Float?   // Temps découpe planifié (sec/pose)
  prodMachineTimeMinOverride      Float?   // Temps machine impression planifié (override, en minutes)
  prodAssemblyTimePerPieceSeconds Float?   // Temps façonnage planifié (sec/pce)
  prodPackTimePerPieceSeconds     Float?   // Temps conditionnement planifié (sec/pce)
  prodInkMlPerPlate               Float?   // Encre planifiée (ml/plaque)
  prodPlatesCount                 Int?     // Nb plaques planifié
  prodTransportCost               Float?   // Coût transport planifié (€ HT)
  prodTransportNotes              String?  // Notes transport / mode prévu

  // ── Façonnage ──
  nbCollages        Int?     // Nombre de collages
  collagePerPLV     Float?   // Mt. collage / PLV
  faconnageNotes    String?  // Description façonnage

  // ── Conditionnement ──
  conditionnementType  String?  // "kit_unitaire" | "caisse" | "palette" | autre
  conditionnementNotes String?  // Description libre

  // ── Amalgame ──
  amalgameScope String?  // 'decoupe' | 'decoupe_impression'

  // ── Bureau d'études ──
  beNotes                  String?
  prodBeTimeMinutesOverride  Int?
  prodBatTimeMinutesOverride Int?

  // ── Impression ──
  impressionNotes          String?
  prodIsRectoVerso         Boolean?
  prodRectoVersoType       String?
  prodHasVarnish           Boolean?
  prodHasFlatColor         Boolean?

  // ── Découpe ──
  decoupeNotes             String?
  prodItemsPerPlate        Int?

  // ── Achats / Accessoires ──
  achatsNotes  String?  // Texte libre accessoires à commander

  // ── Remarques générales ──
  remarques          String?
  delaiRealisation   String?  // Ex : "5 jours ouvrables"

  // ── Plan technique ──
  planImageUrl String?  // URL de l'image téléversée

  // ── Emballage (infos production spécifiques) ──
  packagingBoxLengthMm  Int?     // Longueur réelle de l'étui (mm)
  packagingBoxWidthMm   Int?     // Largeur réelle de l'étui (mm)
  packagingBoxHeightMm  Int?     // Hauteur réelle de l'étui (mm)
  packagingSupplierRef  String?  // Référence fournisseur externe
  packagingNotes        String?  // Notes emballage production
  prodPackagingUnitPrice   Float?   // Prix unitaire confirmé fournisseur (€)
  prodPackagingQuantity    Int?     // Quantité emballage réelle (override)
  prodPackagingMaterial    String?  // Matière emballage (override)

  // ── Statut ──
  status       String   @default("en_attente") // "en_attente" | "en_cours" | "termine"

  // ── Snapshot calculateur (JSON) ──
  formDataJson String?  // Sérialisation complète de l'état du calculateur en mode fiche de prod

  quote                  Quote                   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productionAmalgameRuns ProductionAmalgameRun[]
  productionProductLines ProductionProductLine[]
  productionAchatItems   ProductionAchatItem[]
}

model ProductionAchatItem {
  id                Int             @id @default(autoincrement())
  productionSheetId Int
  name              String
  quantity          Float           @default(1)
  unitPrice         Float?
  position          Int             @default(0)
  productionSheet   ProductionSheet @relation(fields: [productionSheetId], references: [id], onDelete: Cascade)
}

model ProductionAmalgameRun {
  id                Int      @id @default(autoincrement())
  productionSheetId Int
  name              String
  position          Int      @default(0)
  notes             String?
  platesCount       Int?
  productionSheet   ProductionSheet          @relation(fields: [productionSheetId], references: [id], onDelete: Cascade)
  items             ProductionAmalgameItem[]
}

model ProductionAmalgameItem {
  id              Int                   @id @default(autoincrement())
  runId           Int
  name            String
  flatWidth       Int                   // L (mm)
  flatHeight      Int                   // l (mm)
  flatDepth       Int?                  // H (mm) — pour les éléments 3D
  countPerPlate   Int                   @default(1)
  quantityPerUnit Int                   @default(1)
  position        Int                   @default(0)
  run             ProductionAmalgameRun @relation(fields: [runId], references: [id], onDelete: Cascade)
}

model ProductionProductLine {
  id                Int      @id @default(autoincrement())
  productionSheetId Int
  name              String
  position          Int      @default(0)
  plateId           Int?
  productionSheet   ProductionSheet              @relation(fields: [productionSheetId], references: [id], onDelete: Cascade)
  plate             Plate?                       @relation(fields: [plateId], references: [id], onDelete: SetNull)
  elements          ProductionProductLineElement[]
}

model ProductionProductLineElement {
  id         Int                    @id @default(autoincrement())
  lineId     Int
  name       String
  flatWidth  Int
  flatHeight Int
  position   Int                    @default(0)
  plateId    Int?
  line       ProductionProductLine  @relation(fields: [lineId], references: [id], onDelete: Cascade)
  plate      Plate?                 @relation(fields: [plateId], references: [id], onDelete: SetNull)
}

model QuoteActuals {
  id        Int      @id @default(autoincrement())
  quoteId   Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Temps réels par pièce (méthode principale — affichée dans l'UI) ──
  actualCuttingTimePerPoseSeconds   Float?   // Découpe réelle (sec/pose)
  actualMachineTimeMinOverride      Float?   // Temps machine impression réel (override, en minutes)
  actualAssemblyTimePerPieceSeconds Float?   // Façonnage réel (sec/pce)
  actualPackTimePerPieceSeconds     Float?   // Conditionnement réel (sec/pce)

  // ── Matière réelle ──
  actualPlatesUsed                  Int?     // Plaques réellement consommées
  actualWastePercent                Float?   // % de chutes constatées

  // ── Transport réel ──
  actualTransportMode               String?
  actualTransportCost               Float?
  actualWeightKg                    Float?

  // ── Notes libres ──
  notes                             String?

  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}


model Consumable {
  id               Int               @id @default(autoincrement())
  companyId        Int?
  company          Company?          @relation(fields: [companyId], references: [id])
  name             String
  price            Float
  size             Float
  quoteConsumables QuoteConsumable[]
}

model QuoteConsumable {
  id           Int        @id @default(autoincrement())
  quoteId      Int
  consumableId Int
  sizePerItem  Float
  consumable   Consumable @relation(fields: [consumableId], references: [id])
  quote        Quote      @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

model QuoteElement {
  id      Int    @id @default(autoincrement())
  quoteId Int
  name    String
  quantity Int
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

model QuoteAccessory {
  id          Int       @id @default(autoincrement())
  quoteId     Int
  accessoryId Int
  quantity    Int
  accessory   Accessory @relation(fields: [accessoryId], references: [id])
  quote       Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  password           String
  name               String?
  firstName          String?
  lastName           String?
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  permissions        String[]
  role               Role     @default(USER)
  companyId          Int?
  company            Company? @relation(fields: [companyId], references: [id])
  quotes             Quote[]
}

enum Role {
  ADMIN
  USER
}

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  label     String
  unit      String?
  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QuoteProduct {
  id                        Int     @id @default(autoincrement())
  quoteId                   Int
  position                  Int     @default(0)
  productTypeId             Int?
  productTypeName           String?
  flatWidth                 Int     @default(0)
  flatHeight                Int     @default(0)
  quantity                  Int     @default(0)
  plateId                   Int?
  itemsPerPlate             Int?
  platesCount               Int?
  printMode                 String  @default("production")
  isRectoVerso              Boolean @default(false)
  rectoVersoType            String?
  inkMlPerPlate             Int     @default(0)
  inkMlVerso                Int     @default(0)
  varnishSurfacePercent     Int     @default(0)
  flatColorSurfacePercent   Int     @default(0)
  hasVarnish                Boolean @default(false)
  hasFlatColor              Boolean @default(false)
  hasImpression             Boolean @default(true)
  cuttingTimePerPoseSeconds Int     @default(0)
  printSetupType            String  @default("none")
  cuttingSetupType          String  @default("none")
  totalCost                 Float?
  amalgameGroupIndex        Int?
  countPerPlateInGroup      Int?
  machineTimeMinOverride    Float?
  itemsPerPlateOverride     Int?
  bordABord                 Boolean @default(false)
  quote                     Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  plate                     Plate?  @relation(fields: [plateId], references: [id])
}

model QuoteTransportDelivery {
  id            Int     @id @default(autoincrement())
  quoteId       Int
  transportMode String
  department    String
  weightKg      Float?
  units         Int     @default(1)
  optionsHT     Float   @default(0)
  basePriceHT   Float   @default(0)
  totalHT       Float   @default(0)
  quote         Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now())
  companyId  Int?
  company    Company? @relation(fields: [companyId], references: [id])
  userId     String?
  userName   String?
  action     String   // "CREATE_QUOTE" | "DELETE_QUOTE" | "UPSERT_ACTUALS" | "CREATE_USER" | "UPDATE_USER" | "DELETE_USER" | "UPDATE_SETTING"
  entityType String   // "Quote" | "User" | "Setting"
  entityRef  String?  // référence lisible : numéro de devis, email, clé setting
  details    String?  // JSON libre
}

model TransportShipment {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  companyId     Int?
  company       Company? @relation(fields: [companyId], references: [id])
  clientName    String
  plvType       String   // ex: "Présentoir comptoir", "Totem", "Cube"
  plvFormat     String   // ex: "350x276x275mm"
  quantity      Int
  transportMode String   // "PACK30" | "MESSAGERIE_PLUS" | "AFFRETEMENT"
  department    String
  weightKg      Float
  units         Int      // colis ou palettes
  basePriceHT   Float
  optionsHT     Float    @default(0)
  totalHT       Float
  notes         String?
  quoteId       Int?
  quote         Quote?   @relation(fields: [quoteId], references: [id], onDelete: SetNull)
}