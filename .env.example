# Prisma — Connection string PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/kontfeel"

# NextAuth — Générer avec : openssl rand -base64 32
NEXTAUTH_SECRET=""

# NextAuth — URL de l'application
NEXTAUTH_URL="http://localhost:3000"

# NextAuth — Faire confiance au host (utile en dev)
AUTH_TRUST_HOST="true"
